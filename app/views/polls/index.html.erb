<!-- Hero Section -->
<div class="relative py-20 md:py-28">
  <div class="max-w-5xl mx-auto text-center px-4">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 mb-8 px-3 py-1 bg-indigo-50 rounded-full border border-indigo-100">
      <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
      <span class="text-xs font-medium text-indigo-900">Free · No sign-up required</span>
    </div>
    
    <!-- Headline -->
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight tracking-tight">
      <span class="text-gray-900">Create polls that</span>
      <br/>
      <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">people love</span>
    </h1>
    
    <!-- Subheading -->
    <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
      Beautiful polls, instant results. Share with anyone, anywhere.
    </p>
    
    <!-- CTA Button -->
    <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
      <%= link_to new_poll_path, class: "group inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-lg font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all" do %>
        <span>Create your poll</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      <% end %>
      <%= link_to polls_path, class: "inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-gray-900 px-8 py-4 rounded-lg font-semibold text-lg border-2 border-gray-200 hover:border-gray-300 transition-all" do %>
        <span>Browse polls</span>
      <% end %>
    </div>
    
    <p class="text-sm text-gray-500">Join thousands of users worldwide</p>
  </div>
</div>

<!-- Features Grid -->
<div class="max-w-6xl mx-auto px-4 mb-20">
  <div class="grid md:grid-cols-3 gap-8">
    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-2xl transform group-hover:scale-105 transition-transform"></div>
      <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">Lightning Fast</h3>
        <p class="text-gray-600 leading-relaxed">Create beautiful polls in seconds. No registration required.</p>
      </div>
    </div>

    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-100 to-pink-100 rounded-2xl transform group-hover:scale-105 transition-transform"></div>
      <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-purple-600 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">Easy Sharing</h3>
        <p class="text-gray-600 leading-relaxed">Share with unique links and QR codes. Track engagement.</p>
      </div>
    </div>

    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-br from-pink-100 to-rose-100 rounded-2xl transform group-hover:scale-105 transition-transform"></div>
      <div class="relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-pink-600 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">Live Results</h3>
        <p class="text-gray-600 leading-relaxed">Watch votes come in with beautiful real-time charts.</p>
      </div>
    </div>
  </div>
</div>

<!-- Recent Polls -->
<% if @polls.any? %>
  <div class="bg-gradient-to-b from-white to-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
          Recent Polls
        </h2>
        <p class="text-gray-600"><%= @polls.count %> active polls</p>
      </div>
    
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @polls.each do |poll| %>
          <%= link_to poll_path(poll.share_code), class: "group block" do %>
            <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all border border-gray-100 hover:border-indigo-200">
              <!-- Header -->
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-900 line-clamp-2 flex-1 pr-2 group-hover:text-indigo-600 transition-colors">
                  <%= poll.title %>
                </h3>
                <% if poll.closed? %>
                  <span class="shrink-0 px-2.5 py-1 bg-red-50 text-red-700 text-xs font-semibold rounded-full">Closed</span>
                <% else %>
                  <span class="shrink-0 px-2.5 py-1 bg-green-50 text-green-700 text-xs font-semibold rounded-full flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                    Live
                  </span>
                <% end %>
              </div>

              <% if poll.description.present? %>
                <p class="text-sm text-gray-600 mb-4 line-clamp-2 leading-relaxed"><%= poll.description %></p>
              <% end %>

              <!-- Stats -->
              <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <div class="flex items-center gap-4 text-sm">
                  <span class="flex items-center gap-1.5 text-gray-600">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                      <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
                    </svg>
                    <span class="font-medium"><%= poll.options.count %></span>
                  </span>
                  <span class="flex items-center gap-1.5 text-indigo-600 font-bold">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                    </svg>
                    <%= poll.total_votes %>
                  </span>
                </div>
                <svg class="w-5 h-5 text-indigo-600 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
