<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <%= link_to root_path, class: "text-gray-600 hover:text-gray-900 inline-flex items-center" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Home
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h1 class="text-4xl font-bold mb-2 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Create a New Poll</h1>
    <p class="text-gray-600 mb-8">Fill in the details below to create your poll and start collecting votes.</p>

    <%= form_with model: @poll, local: true, class: "space-y-6" do |form| %>
      <% if @poll.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded">
          <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(@poll.errors.count, "error") %> prohibited this poll from being saved:</h3>
          <ul class="list-disc list-inside text-red-700">
            <% @poll.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title, "Poll Question", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :title, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", placeholder: "e.g., What's your favorite programming language?" %>
      </div>

      <div>
        <%= form.label :description, "Description (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :description, rows: 3, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", placeholder: "Add more context to your poll..." %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-3">Poll Options</label>
        <div id="options-container" class="space-y-3">
          <%= form.fields_for :options do |option_form| %>
            <div class="option-field flex items-center gap-2">
              <%= option_form.text_field :title, class: "flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", placeholder: "Enter an option..." %>
              <button type="button" class="remove-option px-4 py-3 bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition font-medium">Remove</button>
            </div>
          <% end %>
        </div>
        <button type="button" id="add-option" class="mt-3 px-4 py-2 bg-blue-100 text-blue-600 rounded-lg hover:bg-blue-200 transition font-medium inline-flex items-center">
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Add Option
        </button>
      </div>

      <div class="bg-gray-50 rounded-lg p-6 space-y-4">
        <h3 class="font-semibold text-gray-900">Advanced Options</h3>
        
        <div class="flex items-center">
          <%= form.check_box :allow_multiple, class: "w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          <%= form.label :allow_multiple, "Allow multiple votes from same person", class: "ml-3 text-gray-700" %>
        </div>

        <div>
          <%= form.label :closes_at, "Close poll at (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.datetime_local_field :closes_at, class: "px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
        </div>
      </div>

      <div class="flex gap-4 pt-4">
        <%= form.submit "Create Poll", class: "flex-1 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-blue-600 hover:to-purple-700 transition-all duration-200 shadow-lg hover:shadow-xl cursor-pointer" %>
        <%= link_to "Cancel", root_path, class: "px-8 py-4 border-2 border-gray-300 text-gray-700 rounded-xl font-semibold hover:bg-gray-50 transition" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('options-container');
    const addButton = document.getElementById('add-option');
    let optionIndex = <%= @poll.options.size %>;

    // Add new option
    addButton.addEventListener('click', function() {
      const optionHtml = `
        <div class="option-field flex items-center gap-2">
          <input type="text" name="poll[options_attributes][${optionIndex}][title]" class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" placeholder="Enter an option...">
          <button type="button" class="remove-option px-4 py-3 bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition font-medium">Remove</button>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', optionHtml);
      optionIndex++;
    });

    // Remove option
    container.addEventListener('click', function(e) {
      if (e.target.classList.contains('remove-option')) {
        const optionFields = container.querySelectorAll('.option-field');
        if (optionFields.length > 2) {
          e.target.closest('.option-field').remove();
        } else {
          alert('A poll must have at least 2 options!');
        }
      }
    });
  });
</script>
