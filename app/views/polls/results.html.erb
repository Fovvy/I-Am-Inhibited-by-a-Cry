<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <%= link_to root_path, class: "text-gray-600 hover:text-gray-900 inline-flex items-center" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Home
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <!-- Poll Header -->
    <div class="mb-8">
      <div class="flex items-start justify-between mb-4">
        <h1 class="text-4xl font-bold text-gray-900 flex-1"><%= @poll.title %></h1>
        <% if @poll.closed? %>
          <span class="ml-4 px-4 py-2 bg-red-100 text-red-600 font-semibold rounded-full">Closed</span>
        <% else %>
          <span class="ml-4 px-4 py-2 bg-green-100 text-green-600 font-semibold rounded-full">Active</span>
        <% end %>
      </div>
      
      <% if @poll.description.present? %>
        <p class="text-gray-600 text-lg mb-6"><%= @poll.description %></p>
      <% end %>

      <div class="flex items-center justify-between">
        <div class="flex items-center text-sm text-gray-500 space-x-4">
          <span class="flex items-center">
            <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
            <strong><%= @poll.total_votes %></strong>&nbsp;<%= 'vote'.pluralize(@poll.total_votes) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Chart Visualization -->
    <div class="mb-8 bg-gray-50 rounded-xl p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Results</h2>
      <canvas id="pollChart" class="max-w-2xl mx-auto" height="300"></canvas>
    </div>

    <!-- Detailed Results -->
    <div class="space-y-4 mb-8">
      <h3 class="text-xl font-semibold text-gray-900 mb-4">Detailed Breakdown</h3>
      <% @poll.options.order(vote_count: :desc).each_with_index do |option, index| %>
        <div class="relative">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center">
              <span class="inline-flex items-center justify-center w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 text-white rounded-lg font-bold mr-3">
                <%= index + 1 %>
              </span>
              <span class="font-semibold text-gray-900"><%= option.title %></span>
            </div>
            <div class="text-right">
              <span class="text-2xl font-bold text-gray-900"><%= option.vote_count %></span>
              <span class="text-gray-500 ml-2">(<%= option.percentage %>%)</span>
            </div>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-500 to-purple-600 h-3 rounded-full transition-all duration-500" style="width: <%= option.percentage %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Share Section -->
    <div class="border-t border-gray-200 pt-8">
      <h3 class="text-xl font-semibold text-gray-900 mb-4">Share This Poll</h3>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Poll Link</label>
          <div class="flex">
            <input type="text" value="<%= poll_url(@poll.share_code) %>" readonly id="poll-link" class="flex-1 px-4 py-3 border border-gray-300 rounded-l-lg bg-gray-50 text-gray-700 font-mono text-sm">
            <button onclick="copyLink()" class="px-6 py-3 bg-blue-500 text-white rounded-r-lg hover:bg-blue-600 transition font-semibold">
              Copy
            </button>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">QR Code</label>
          <div class="flex items-center space-x-4">
            <%= link_to qr_code_poll_path(@poll.share_code), target: "_blank", class: "inline-flex items-center px-6 py-3 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition font-semibold" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
              </svg>
              View QR Code
            <% end %>
            <% unless @poll.closed? %>
              <%= link_to poll_path(@poll.share_code), class: "inline-flex items-center px-6 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition font-semibold" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
                </svg>
                Vote Now
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function copyLink() {
    const linkInput = document.getElementById('poll-link');
    linkInput.select();
    linkInput.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(linkInput.value);
    
    const button = event.target;
    const originalText = button.textContent;
    button.textContent = 'Copied!';
    button.classList.remove('bg-blue-500', 'hover:bg-blue-600');
    button.classList.add('bg-green-500');
    
    setTimeout(() => {
      button.textContent = originalText;
      button.classList.remove('bg-green-500');
      button.classList.add('bg-blue-500', 'hover:bg-blue-600');
    }, 2000);
  }

  // Chart.js visualization
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('pollChart').getContext('2d');
    const data = <%= raw @chart_data.to_json %>;
    
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: data.map(item => item[0]),
        datasets: [{
          label: 'Votes',
          data: data.map(item => item[1]),
          backgroundColor: [
            'rgba(59, 130, 246, 0.8)',
            'rgba(147, 51, 234, 0.8)',
            'rgba(236, 72, 153, 0.8)',
            'rgba(34, 197, 94, 0.8)',
            'rgba(251, 146, 60, 0.8)',
            'rgba(14, 165, 233, 0.8)',
          ],
          borderColor: [
            'rgba(59, 130, 246, 1)',
            'rgba(147, 51, 234, 1)',
            'rgba(236, 72, 153, 1)',
            'rgba(34, 197, 94, 1)',
            'rgba(251, 146, 60, 1)',
            'rgba(14, 165, 233, 1)',
          ],
          borderWidth: 2,
          borderRadius: 8,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 12,
            titleFont: {
              size: 14,
              weight: 'bold'
            },
            bodyFont: {
              size: 13
            },
            borderColor: 'rgba(255, 255, 255, 0.2)',
            borderWidth: 1
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1,
              font: {
                size: 12
              }
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            }
          },
          x: {
            ticks: {
              font: {
                size: 12,
                weight: 'bold'
              }
            },
            grid: {
              display: false
            }
          }
        }
      }
    });
  });
</script>
