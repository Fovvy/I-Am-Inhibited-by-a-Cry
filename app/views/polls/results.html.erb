<div class="max-w-4xl mx-auto">
  <!-- Back Button -->
  <%= link_to root_path, class: "group inline-flex items-center mb-6 text-gray-600 hover:text-rose-600 font-semibold transition-colors" do %>
    <div class="w-8 h-8 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center mr-2 shadow-md group-hover:shadow-lg transition-all border-2 border-gray-200 group-hover:border-rose-300">
      <svg class="w-4 h-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    </div>
    <span>Back to Home</span>
  <% end %>

  <!-- Main Results Card -->
  <div class="relative bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl p-6 md:p-10 border-4 border-white/50 overflow-hidden">
    <!-- Decorative Background -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-gradient-to-br from-amber-200 to-rose-200 rounded-full blur-3xl opacity-20"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-gradient-to-br from-violet-200 to-pink-200 rounded-full blur-3xl opacity-20"></div>
    
    <!-- Status Badge -->
    <div class="absolute -top-4 -right-4 z-10">
      <% if @poll.closed? %>
        <div class="bg-gradient-to-r from-red-400 to-pink-500 text-white px-6 py-2 rounded-full text-sm font-black shadow-xl flex items-center space-x-2">
          <span class="text-xl">🔒</span>
          <span>Poll Closed</span>
        </div>
      <% else %>
        <div class="bg-gradient-to-r from-emerald-400 to-teal-500 text-white px-6 py-2 rounded-full text-sm font-black shadow-xl flex items-center space-x-2 animate-pulse">
          <span class="text-xl">📊</span>
          <span>Live Results</span>
        </div>
      <% end %>
    </div>

    <!-- Poll Header -->
    <div class="mb-8 mt-4 relative z-10">
      <h1 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 leading-tight">
        <%= @poll.title %>
      </h1>
      
      <% if @poll.description.present? %>
        <p class="text-lg text-gray-700 mb-4 leading-relaxed"><%= @poll.description %></p>
      <% end %>

      <div class="inline-flex items-center space-x-2 bg-gradient-to-r from-rose-100 to-pink-100 px-6 py-3 rounded-full shadow-md">
        <svg class="w-6 h-6 text-rose-600" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
        </svg>
        <span class="font-black text-2xl text-rose-700"><%= @poll.total_votes %></span>
        <span class="font-bold text-gray-700">total votes</span>
      </div>
    </div>

    <!-- Chart Visualization -->
    <div class="mb-8 bg-gradient-to-br from-amber-50 via-rose-50 to-violet-50 rounded-3xl p-6 md:p-8 shadow-inner border-2 border-white/50 relative z-10">
      <h2 class="text-2xl md:text-3xl font-black text-gray-900 mb-6 flex items-center">
        <span class="text-4xl mr-3">📊</span>
        Visual Breakdown
      </h2>
      <canvas id="pollChart" class="w-full" height="280"></canvas>
    </div>

    <!-- Detailed Results -->
    <div class="space-y-4 mb-8 relative z-10">
      <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center">
        <span class="text-3xl mr-2">🏆</span>
        Leaderboard
      </h3>
      <% @poll.options.order(vote_count: :desc).each_with_index do |option, index| %>
        <div class="relative group">
          <% medal = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣', '6️⃣', '7️⃣', '8️⃣', '9️⃣', '🔟'][index] %>
          <div class="flex items-center justify-between mb-2 bg-white/80 backdrop-blur-sm rounded-2xl p-4 shadow-md hover:shadow-lg transition-all border-2 <%= index == 0 ? 'border-amber-300' : 'border-gray-200' %>">
            <div class="flex items-center flex-1 min-w-0 space-x-3">
              <span class="text-3xl transform group-hover:scale-125 transition-transform"><%= medal %></span>
              <span class="font-black text-lg md:text-xl text-gray-900 truncate"><%= option.title %></span>
            </div>
            <div class="text-right ml-4 shrink-0">
              <div class="text-2xl md:text-3xl font-black bg-gradient-to-r from-rose-600 to-violet-600 bg-clip-text text-transparent">
                <%= option.vote_count %>
              </div>
              <div class="text-xs font-bold text-gray-500">(<%= option.percentage %>%)</div>
            </div>
          </div>
          <div class="w-full bg-gradient-to-r from-gray-200 to-gray-100 rounded-full h-4 overflow-hidden shadow-inner">
            <div class="bg-gradient-to-r <%= ['from-amber-400 to-orange-500', 'from-gray-300 to-gray-400', 'from-orange-400 to-amber-600', 'from-violet-400 to-purple-500', 'from-rose-400 to-pink-500', 'from-blue-400 to-cyan-500'][index % 6] %> h-4 rounded-full transition-all duration-1000 ease-out shadow-md" style="width: <%= option.percentage %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Share Section -->
    <div class="border-t-4 border-rose-200 pt-8 relative z-10">
      <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center">
        <span class="text-3xl mr-2">🚀</span>
        Share & Spread the Word
      </h3>
      
      <div class="space-y-4">
        <div class="bg-gradient-to-br from-rose-50 to-pink-50 rounded-2xl p-5 border-2 border-rose-200">
          <label class="block text-sm font-bold text-gray-700 mb-3 flex items-center">
            <span class="text-xl mr-2">🔗</span>
            Your Unique Poll Link
          </label>
          <div class="flex gap-2">
            <input type="text" value="<%= poll_url(@poll.share_code) %>" readonly id="poll-link" class="flex-1 px-4 py-3 border-2 border-rose-200 rounded-xl bg-white text-gray-700 font-mono text-sm font-semibold focus:border-rose-400 focus:ring-2 focus:ring-rose-200 transition-all">
            <button onclick="copyLink()" id="copy-btn" class="group relative">
              <div class="absolute inset-0 bg-gradient-to-r from-violet-400 to-purple-500 rounded-xl blur opacity-60 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative px-6 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white rounded-xl font-black hover:from-violet-600 hover:to-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                <span>Copy</span>
              </div>
            </button>
          </div>
        </div>
        
        <div class="grid sm:grid-cols-2 gap-3">
          <%= link_to qr_code_poll_path(@poll.share_code), target: "_blank", class: "group relative" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-amber-300 to-orange-400 rounded-xl blur opacity-40 group-hover:opacity-60 transition-opacity"></div>
            <div class="relative bg-gradient-to-r from-amber-400 to-orange-500 text-white p-4 rounded-xl font-black shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all flex items-center justify-center space-x-3 border-2 border-white/50">
              <span class="text-2xl">📱</span>
              <span>Get QR Code</span>
            </div>
          <% end %>
          
          <% unless @poll.closed? %>
            <%= link_to poll_path(@poll.share_code), class: "group relative" do %>
              <div class="absolute inset-0 bg-gradient-to-r from-emerald-300 to-teal-400 rounded-xl blur opacity-40 group-hover:opacity-60 transition-opacity"></div>
              <div class="relative bg-gradient-to-r from-emerald-400 to-teal-500 text-white p-4 rounded-xl font-black shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all flex items-center justify-center space-x-3 border-2 border-white/50">
                <span class="text-2xl">🗳️</span>
                <span>Vote Again</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function copyLink() {
    const linkInput = document.getElementById('poll-link');
    const copyBtn = document.getElementById('copy-btn');
    
    linkInput.select();
    linkInput.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(linkInput.value);
    
    // Fun animation and feedback
    copyBtn.innerHTML = `
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-400 to-teal-500 rounded-xl blur opacity-100 transition-opacity"></div>
      <div class="relative px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-xl font-black shadow-lg flex items-center space-x-2">
        <span class="text-xl">✅</span>
        <span>Copied!</span>
      </div>
    `;
    
    setTimeout(() => {
      copyBtn.innerHTML = `
        <div class="absolute inset-0 bg-gradient-to-r from-violet-400 to-purple-500 rounded-xl blur opacity-60 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative px-6 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white rounded-xl font-black hover:from-violet-600 hover:to-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span>Copy</span>
        </div>
      `;
    }, 2000);
  }

  // Chart.js visualization with vibrant colors
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('pollChart').getContext('2d');
    const data = <%= raw @chart_data.to_json %>;
    
    const vibrantGradients = data.map((item, index) => {
      const gradient = ctx.createLinearGradient(0, 0, 0, 400);
      const colors = [
        ['#fbbf24', '#f59e0b'], // Amber
        ['#a855f7', '#7c3aed'], // Purple
        ['#ec4899', '#db2777'], // Pink
        ['#10b981', '#059669'], // Emerald
        ['#f97316', '#ea580c'], // Orange
        ['#3b82f6', '#2563eb'], // Blue
        ['#8b5cf6', '#6d28d9'], // Violet
        ['#f43f5e', '#e11d48'], // Rose
      ];
      const [start, end] = colors[index % colors.length];
      gradient.addColorStop(0, start);
      gradient.addColorStop(1, end);
      return gradient;
    });
    
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: data.map(item => item[0]),
        datasets: [{
          label: 'Votes',
          data: data.map(item => item[1]),
          backgroundColor: vibrantGradients,
          borderColor: 'rgba(255, 255, 255, 0.8)',
          borderWidth: 3,
          borderRadius: 16,
          hoverBackgroundColor: vibrantGradients,
          hoverBorderColor: '#fff',
          hoverBorderWidth: 4,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        animation: {
          duration: 1500,
          easing: 'easeInOutQuart'
        },
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(17, 24, 39, 0.95)',
            padding: 16,
            titleFont: {
              size: 16,
              weight: 'bold',
              family: 'system-ui'
            },
            bodyFont: {
              size: 14,
              family: 'system-ui'
            },
            borderColor: 'rgba(251, 191, 36, 0.5)',
            borderWidth: 2,
            cornerRadius: 12,
            displayColors: true,
            boxPadding: 8
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1,
              font: {
                size: 13,
                weight: 'bold',
                family: 'system-ui'
              },
              color: '#374151'
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.06)',
              lineWidth: 2
            },
            border: {
              color: '#d1d5db',
              width: 2
            }
          },
          x: {
            ticks: {
              font: {
                size: 13,
                weight: 'bold',
                family: 'system-ui'
              },
              color: '#1f2937',
              maxRotation: 45,
              minRotation: 0
            },
            grid: {
              display: false
            },
            border: {
              color: '#d1d5db',
              width: 2
            }
          }
        }
      }
    });
  });
</script>
