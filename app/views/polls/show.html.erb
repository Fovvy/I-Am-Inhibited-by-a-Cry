<div class="max-w-2xl mx-auto">
  <!-- Back Button -->
  <%= link_to root_path, class: "group inline-flex items-center mb-6 text-gray-600 hover:text-rose-600 font-semibold transition-colors" do %>
    <div class="w-8 h-8 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center mr-2 shadow-md group-hover:shadow-lg transition-all border-2 border-gray-200 group-hover:border-rose-300">
      <svg class="w-4 h-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    </div>
    <span>Back to Home</span>
  <% end %>

  <!-- Main Poll Card -->
  <div class="relative bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl p-6 md:p-10 border-4 border-white/50 overflow-hidden">
    <!-- Decorative Background -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-rose-200 to-violet-200 rounded-full blur-3xl opacity-20 -z-10"></div>
    
    <!-- Status Badge -->
    <div class="absolute -top-4 -right-4">
      <% if @poll.closed? %>
        <div class="bg-gradient-to-r from-red-400 to-pink-500 text-white px-6 py-2 rounded-full text-sm font-black shadow-xl flex items-center space-x-2">
          <span class="text-xl">🔒</span>
          <span>Poll Closed</span>
        </div>
      <% else %>
        <div class="bg-gradient-to-r from-emerald-400 to-teal-500 text-white px-6 py-2 rounded-full text-sm font-black shadow-xl flex items-center space-x-2 animate-pulse">
          <span class="text-xl">✨</span>
          <span>Live Now</span>
        </div>
      <% end %>
    </div>

    <!-- Poll Header -->
    <div class="mb-8 mt-4">
      <h1 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 leading-tight">
        <%= @poll.title %>
      </h1>
      
      <% if @poll.description.present? %>
        <p class="text-lg text-gray-700 mb-4 leading-relaxed"><%= @poll.description %></p>
      <% end %>

      <div class="flex items-center space-x-4 text-sm">
        <div class="flex items-center space-x-2 bg-gradient-to-r from-rose-100 to-pink-100 px-4 py-2 rounded-full">
          <svg class="w-5 h-5 text-rose-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
          </svg>
          <span class="font-black text-rose-700"><%= @poll.total_votes %> votes</span>
        </div>
        <% if @poll.closes_at.present? %>
          <div class="flex items-center space-x-2 bg-gradient-to-r from-violet-100 to-purple-100 px-4 py-2 rounded-full">
            <svg class="w-5 h-5 text-violet-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            <span class="font-bold text-violet-700">Closes <%= @poll.closes_at.strftime("%b %d") %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Voting Form -->
    <%= form_with url: vote_poll_path(@poll.share_code), method: :post, local: true do |form| %>
      <div class="mb-8">
        <h2 class="text-2xl font-black text-gray-900 mb-5 flex items-center">
          <span class="text-3xl mr-2">🗳️</span>
          Cast Your Vote
        </h2>
        
        <div class="space-y-3">
          <% @poll.options.each_with_index do |option, index| %>
            <label class="group block relative">
              <input type="radio" name="option_id" value="<%= option.id %>" class="peer hidden" />
              <div class="flex items-center p-5 border-3 border-gray-300 rounded-2xl hover:border-rose-400 peer-checked:border-rose-500 peer-checked:bg-gradient-to-r peer-checked:from-rose-50 peer-checked:to-pink-50 transition-all cursor-pointer shadow-md hover:shadow-xl transform hover:-translate-y-1 peer-checked:shadow-2xl">
                <div class="w-8 h-8 rounded-full border-3 border-gray-400 peer-checked:border-rose-500 peer-checked:bg-rose-500 flex items-center justify-center mr-4 transition-all">
                  <svg class="w-5 h-5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-rose-600 transition-colors flex-1">
                  <%= option.title %>
                </span>
                <span class="text-3xl opacity-0 group-hover:opacity-100 transition-opacity"><%= ['🎯', '⚡', '🔥', '✨', '💫', '🌟'][index % 6] %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="relative group mb-6">
        <div class="absolute inset-0 bg-gradient-to-r from-rose-400 to-violet-500 rounded-2xl blur-lg opacity-60 group-hover:opacity-100 transition-opacity"></div>
        <%= form.submit "Submit My Vote 🚀", class: "relative w-full bg-gradient-to-r from-rose-500 to-violet-600 text-white px-8 py-5 rounded-2xl font-black text-xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-1 transition-all duration-300 cursor-pointer border-4 border-white/50" %>
      </div>
    <% end %>

    <!-- View Results -->
    <div class="text-center pt-6 border-t-2 border-gray-200">
      <%= link_to results_poll_path(@poll.share_code), class: "inline-flex items-center space-x-2 text-gray-600 hover:text-rose-600 font-bold transition-colors group" do %>
        <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span>View Live Results 📊</span>
      <% end %>
    </div>
  </div>
</div>
