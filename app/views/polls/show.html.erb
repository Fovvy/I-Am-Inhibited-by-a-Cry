<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to root_path, class: "text-gray-600 hover:text-gray-900 inline-flex items-center text-sm" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Home
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-lg p-5 md:p-8 border border-gray-100">
    <!-- Poll Header -->
    <div class="mb-6">
      <div class="flex items-start justify-between mb-3">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 flex-1"><%= @poll.title %></h1>
        <% if @poll.closed? %>
          <span class="shrink-0 ml-3 px-3 py-1 bg-red-100 text-red-700 font-semibold rounded-full text-xs">Closed</span>
        <% else %>
          <span class="shrink-0 ml-3 px-3 py-1 bg-green-100 text-green-700 font-semibold rounded-full text-xs">Active</span>
        <% end %>
      </div>
      
      <% if @poll.description.present? %>
        <p class="text-gray-600 text-base mb-4"><%= @poll.description %></p>
      <% end %>

      <div class="flex items-center text-xs md:text-sm text-gray-500 space-x-3 md:space-x-4">
        <span class="flex items-center font-semibold">
          <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
          </svg>
          <%= @poll.total_votes %> votes
        </span>
        <% if @poll.closes_at.present? %>
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            <%= @poll.closes_at.strftime("%b %d") %>
          </span>
        <% end %>
      </div>
    </div>

    <!-- Voting Options -->
    <div class="space-y-4 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Cast Your Vote</h2>
      <%= form_with url: vote_poll_path(@poll.share_code), method: :post, local: true do |form| %>
        <div class="space-y-2">
          <% @poll.options.each do |option| %>
            <label class="flex items-center p-3 md:p-4 border-2 border-gray-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 transition cursor-pointer group">
              <%= radio_button_tag 'option_id', option.id, false, class: "w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" %>
              <span class="ml-3 text-base font-medium text-gray-900 group-hover:text-blue-600"><%= option.title %></span>
            </label>
          <% end %>
        </div>

        <div class="mt-5">
          <%= form.submit "Submit Vote", class: "w-full bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-3 rounded-lg font-bold hover:from-blue-600 hover:to-purple-700 transition-all duration-200 shadow-md hover:shadow-lg cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- View Results Link -->
    <div class="text-center pt-4 border-t border-gray-200">
      <%= link_to results_poll_path(@poll.share_code), class: "text-blue-600 hover:text-blue-700 font-semibold inline-flex items-center text-sm" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        View Results
      <% end %>
    </div>
  </div>
</div>
